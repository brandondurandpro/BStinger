    {
      "id": 4,
      "type": "timeseries",
      "title": "Error rate per operation",
      "description": "Share of operations that ended with outcome=\"error\".",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (operation) (rate(kotlin_editor_operation_duration_seconds_count{outcome=\"error\", operation=~\"$operation\", service_version=~\"$service_version\"}[$__rate_interval]))\n/\nsum by (operation) (rate(kotlin_editor_operation_duration_seconds_count{operation=~\"$operation\", service_version=~\"$service_version\"}[$__rate_interval]))",
          "legendFormat": "{{operation}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate per operation",
      "description": "Operations per second, all outcomes.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (operation) (rate(kotlin_editor_operation_duration_seconds_count{operation=~\"$operation\", service_version=~\"$service_version\"}[$__rate_interval]))",
          "legendFormat": "{{operation}}",
          "refId": "A",
          "range": true,
