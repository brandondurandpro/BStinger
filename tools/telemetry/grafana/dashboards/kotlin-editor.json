      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "RPC p95: client vs server vs network",
      "description": "p95 seen by the client, p95 spent in the server, and their difference as an estimate of the network time (a difference of percentiles, not the percentile of the difference).",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kotlin_editor_operation_duration_seconds_bucket{operation=\"rpc.client\", side=\"client\", service_version=~\"$service_version\"}[$__rate_interval])))",
          "legendFormat": "client (rpc.client)",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kotlin_editor_operation_duration_seconds_bucket{operation=\"rpc.server\", side=\"server\", service_version=~\"$service_version\"}[$__rate_interval])))",
          "legendFormat": "server (rpc.server)",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(kotlin_editor_operation_duration_seconds_bucket{operation=\"rpc.client\", side=\"client\", service_version=~\"$service_version\"}[$__rate_interval]))))\n-\n(histogram_quantile(0.95, sum by (le) (rate(kotlin_editor_operation_duration_seconds_bucket{operation=\"rpc.server\", side=\"server\", service_version=~\"$service_version\"}[$__rate_interval]))))",
          "legendFormat": "network (client - server)",
          "refId": "C",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "app.startup p50 / p95 by service_version",
      "description": "Startup duration per version over the dashboard time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.5, sum by (le, service_version) (increase(kotlin_editor_operation_duration_seconds_bucket{operation=\"app.startup\", service_version=~\"$service_version\"}[$__range])))",
          "legendFormat": "{{service_version}} p50",
          "refId": "A",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service_version) (increase(kotlin_editor_operation_duration_seconds_bucket{operation=\"app.startup\", service_version=~\"$service_version\"}[$__range])))",
          "legendFormat": "{{service_version}} p95",
          "refId": "B",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "app.startup p95 over time by service_version",
      "description": "Startups are rare, so this uses a 1h window.",
